      "key": "inference_latency_ms"
    },
    {
      "title": "Temperature (simulated demo only)",
      "type": "time_series",
      "key": "temperature_c"
    },
    {
      "title": "Humidity (simulated demo only)",
      "type": "time_series",
      "key": "humidity_pct"
    },
    {
      "title": "Soil Moisture (simulated demo only)",
      "type": "time_series",
      "key": "soil_moisture_pct"
    },
    {
      "title": "Battery Voltage (simulated demo only)",
      "type": "time_series",
      "key": "battery_v"
    }
